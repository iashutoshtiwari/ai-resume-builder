# AI Provider Selection: 'google' (default) or 'openrouter'
AI_PROVIDER=google

# Google AI Studio (Free tier supported)
# Get your key at https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_DATA_TIER=free

# OpenRouter (Alternative provider)
# Get your key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
OPENROUTER_MAX_TOKENS=4096

# Optional: Remote LaTeX Compiler (Google Cloud Run 100% Free Tier)
# Deploy via ./docker/latex-compiler/deploy-free.sh or .ps1
# Required for PDF compilation; run the Docker compiler locally or configure its deployed URL.
LATEX_COMPILER_URL=
