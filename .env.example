# AI Provider Selection: 'google' (default), 'groq', or 'openrouter'
# Users can also switch providers on the fly in the GUI header
AI_PROVIDER=google

# Google AI Studio (Pro / Free tier supported)
# Get your key at https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_DATA_TIER=free

# Groq LPU (14,400 Free Requests/Day — 100% Free Forever, No Credit Card Required)
# Get your free key in 30 seconds at https://console.groq.com/keys
# Ultra-fast (~300 tok/s) LPU inference with OpenAI's GPT-OSS 120B
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Public Deployment Abuse Prevention & Budget Protection
# Global hard daily request cap across all users (circuit breaker)
DAILY_AI_REQUEST_LIMIT=500
# IP-based rate limiting per 10-minute window
RATE_LIMIT_HEAVY_MAX=6
RATE_LIMIT_MEDIUM_MAX=12

# OpenRouter (Alternative multi-model provider)
# Get your key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
OPENROUTER_MAX_TOKENS=2500

# Optional: Remote LaTeX Compiler (Google Cloud Run 100% Free Tier)
# Deploy via ./docker/latex-compiler/deploy-free.sh or .ps1
# Required for PDF compilation; run the Docker compiler locally or configure its deployed URL.
LATEX_COMPILER_URL=
